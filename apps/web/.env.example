DATABASE_URL=postgresql://ai_catalyst:ai_catalyst@127.0.0.1:5432/ai_catalyst

APP_ENV=local
SERVICE_NAME=aicatalyst-web
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_APP_ENV=local
# RELEASE=

# Chromium HTML → PDF (printable Interview Guide / migrated workbooks).
# docker-compose sets this to http://gotenberg:3000 for the web service.
GOTENBERG_URL=http://127.0.0.1:3001
BETTER_AUTH_SECRET=
# Also Better Auth's baseURL. The Google redirect URI registered in the Google
# console must be exactly `${AUTH_ISSUER_URL}/api/auth/callback/google` —
# a mismatched scheme, trailing slash, or apex-vs-www is the usual cause of
# redirect_uri_mismatch.
AUTH_ISSUER_URL=http://localhost:3000

# Google sign-in. Required only when AUTH_GOOGLE_ENABLED is true in
# apps/web/lib/feature-flags.ts — while that flag is false, lib/auth.ts does
# not read these and the app boots without them.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# This server's own public MCP resource URL — used only for the /mcp/authorize
# before-hook's best-effort RFC 8707 `resource` parameter cross-check (see
# apps/web/lib/mcp-oauth-compat/hooks.ts). Must match apps/mcp's own
# MCP_RESOURCE_URL exactly.
MCP_RESOURCE_URL=http://localhost:8787/mcp

# Behind ALB / reverse proxy (Staging/Production): trust X-Forwarded-For for DCR.
# MCP_OAUTH_TRUST_PROXY_HEADERS=true

# Storage / email — wired into StorageConfig / EmailConfig in packages/services.
# Defaults keep local and CI offline-friendly.
#
# EMAIL_PROVIDER=noop discards mail and prints sign-in codes to the server
# console. That is the right default here (APP_ENV=local above); lib/email.ts
# only refuses to boot on noop when APP_ENV is explicitly staging or
# production, where it would otherwise leave users waiting for mail that never
# arrives while live sign-in codes accumulate in the logs.
# STORAGE_PROVIDER=local
# EMAIL_PROVIDER=noop
# EMAIL_PROVIDER=ses
# EMAIL_FROM=noreply@example.com
# AWS_REGION=ap-southeast-2
