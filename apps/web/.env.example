DATABASE_URL=postgresql://ai_catalyst:ai_catalyst@127.0.0.1:5432/ai_catalyst

# Chromium HTML → PDF (printable Interview Guide / migrated workbooks).
# docker-compose sets this to http://gotenberg:3000 for the web service.
GOTENBERG_URL=http://127.0.0.1:3001
BETTER_AUTH_SECRET=
AUTH_ISSUER_URL=http://localhost:3000
# This server's own public MCP resource URL — used only for the /mcp/authorize
# before-hook's best-effort RFC 8707 `resource` parameter cross-check (see
# apps/web/lib/mcp-oauth-compat/hooks.ts). Must match apps/mcp's own
# MCP_RESOURCE_URL exactly.
MCP_RESOURCE_URL=http://localhost:8787/mcp

# Behind ALB / reverse proxy (Staging/Production): trust X-Forwarded-For for DCR.
# MCP_OAUTH_TRUST_PROXY_HEADERS=true

# Storage / email — wired into StorageConfig / EmailConfig in packages/services.
# Defaults keep local and CI offline-friendly.
# STORAGE_PROVIDER=local
# EMAIL_PROVIDER=noop
