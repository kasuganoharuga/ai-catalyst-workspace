DATABASE_URL=postgresql://ai_catalyst:ai_catalyst@127.0.0.1:5432/ai_catalyst

APP_ENV=local
SERVICE_NAME=aicatalyst-mcp
# SENTRY_DSN=
# RELEASE=

MCP_PORT=8787
# Comma-separated Host header allowlist. Unset defaults to localhost,127.0.0.1,mcp
# — a deployed hostname then 403s `Invalid Host` and Claude reports that the
# URL is not a valid MCP server. Production Terraform sets the public host.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# Deployed environments also include the connector Origins (claude.ai,
# chatgpt.com, chat.openai.com) — see production Terraform.
MCP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public-facing URLs only, for OAuth discovery metadata (RFC 9728) — apps/mcp
# verifies platform Bearer tokens by querying Postgres directly
# (DATABASE_URL above), never by calling apps/web over HTTP.
# Must match apps/web's own MCP_RESOURCE_URL exactly.
MCP_RESOURCE_URL=http://localhost:8787/mcp
# apps/web's Authorization Server base URL (its own AUTH_ISSUER_URL).
AUTH_ISSUER_URL=http://localhost:3000

# Cloud (see infra/aws/README.md)
# STORAGE_PROVIDER=s3
# STORAGE_CONTAINER=ai-catalyst-artifacts-staging
# AWS_REGION=ap-southeast-2
# EMAIL_PROVIDER=ses
# EMAIL_FROM=noreply@example.com
