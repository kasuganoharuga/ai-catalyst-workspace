{
  "version": "0.1.0",
  "title": "AI Catalyst Founder Toolkit",
  "description": "A structured founder workflow toolkit for moving from raw idea to validation-ready plan.",
  "modules": [
    {
      "id": "module-00-setup",
      "number": "00",
      "slug": "setup",
      "title": "Workspace Setup",
      "objective": "Prepare the context, files, and assumptions the rest of the toolkit builds on.",
      "founderInputs": [
        "Founder background",
        "Company or idea summary",
        "Known constraints",
        "Existing notes or artefacts"
      ],
      "outputs": [
        "Workspace context brief",
        "Input checklist",
        "Module readiness map"
      ],
      "status": "draft",
      "skillPath": "/skills/module-00-setup",
      "modulePath": "modules/module-00-setup.md"
    },
    {
      "id": "module-01-pressure-test",
      "number": "01",
      "slug": "pressure-test",
      "title": "Pressure-Test Your Idea",
      "objective": "Work out whether an idea is worth pursuing, before over-investing in it.",
      "founderInputs": [
        "Business idea",
        "Target customer",
        "Problem being solved",
        "Current evidence",
        "Key assumptions"
      ],
      "outputs": [
        "Pressure-test verdict",
        "Proceed, pivot, or kill recommendation",
        "Key risks",
        "Next-step actions"
      ],
      "status": "draft",
      "skillPath": "/skills/module-01-pressure-test",
      "modulePath": "modules/module-01-pressure-test.md"
    },
    {
      "id": "module-02-customer-avatar",
      "number": "02",
      "slug": "customer-avatar",
      "title": "Ideal Customer Avatar",
      "objective": "Define exactly who you are building for, what they urgently need, how to recognise when they are ready to buy, and who should not be included.",
      "founderInputs": [
        "Module 01 target customer and problem",
        "Pain intensity signals",
        "Buying or adoption context",
        "Existing interview notes"
      ],
      "outputs": [
        "Beachhead segment and snapshot",
        "Customer situation",
        "Unmet needs, functional and emotional",
        "Tiered buying signals",
        "Disqualifiers",
        "Core promise",
        "Validation status and one-week validation plan"
      ],
      "status": "draft",
      "skillPath": "/skills/module-02-customer-avatar",
      "modulePath": "modules/module-02-customer-avatar.md"
    },
    {
      "id": "module-03-problem-statement",
      "number": "03",
      "slug": "problem-statement",
      "title": "Problem Statement & Five Whys",
      "objective": "Drive the beachhead customer's surface complaint down to a structural root cause, and turn it into five interview questions the Founder can take to real customers.",
      "founderInputs": [
        "Beachhead segment and customer situation",
        "Unmet functional and emotional needs",
        "Current alternatives customers use today"
      ],
      "outputs": [
        "Root-cause problem statement",
        "Five Whys ladder",
        "Pain intensity and priority evidence",
        "Problem interview guide"
      ],
      "status": "draft",
      "skillPath": "/skills/module-03-problem-statement",
      "modulePath": "modules/module-03-problem-statement.md"
    },
    {
      "id": "module-04-evidence-of-unmet-need",
      "number": "04",
      "slug": "evidence-of-unmet-need",
      "title": "Evidence of Unmet Need",
      "objective": "Reconcile what the Founder believes against what they have actually observed, grade the evidence, and plan the next 30 days of validation.",
      "founderInputs": [
        "Problem interview notes",
        "Observed customer behaviour",
        "Time, budget and access constraints"
      ],
      "outputs": [
        "Evidence inventory and maturity level",
        "Behavioural evidence log",
        "Falsifiability test",
        "30-day validation roadmap"
      ],
      "status": "draft",
      "skillPath": "/skills/module-04-evidence-of-unmet-need",
      "modulePath": "modules/module-04-evidence-of-unmet-need.md"
    },
    {
      "id": "module-05-solution-options",
      "number": "05",
      "slug": "solution-options",
      "title": "Solution Options",
      "objective": "Generate and compare solution paths without prematurely locking into one product direction.",
      "founderInputs": [
        "Problem statement",
        "Customer constraints",
        "Existing alternatives",
        "Founder capabilities"
      ],
      "outputs": [
        "Solution option set",
        "Trade-off comparison",
        "Recommended first wedge",
        "Risks by option"
      ],
      "status": "draft",
      "skillPath": "/skills/module-05-solution-options",
      "modulePath": "modules/module-05-solution-options.md"
    },
    {
      "id": "module-06-validation-plan",
      "number": "06",
      "slug": "validation-plan",
      "title": "Validation Plan",
      "objective": "Translate the chosen wedge into a focused validation plan with evidence goals and next actions.",
      "founderInputs": [
        "Preferred solution option",
        "Top assumptions",
        "Available channels",
        "Time and budget constraints"
      ],
      "outputs": [
        "Validation plan",
        "Experiment backlog",
        "Evidence thresholds",
        "Founder action plan"
      ],
      "status": "draft",
      "skillPath": "/skills/module-06-validation-plan",
      "modulePath": "modules/module-06-validation-plan.md"
    }
  ]
}
