{
  "name": "@ai-catalyst/services",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Application Service Layer — the single home for business logic, consumed by apps/web route handlers and apps/mcp tool handlers. The only layer permitted to call apps/api (for internal AI calls).",
  "exports": {
    "./workflow": "./src/workflow/index.ts",
    "./attempt": "./src/attempt/index.ts",
    "./attempt/internal/interaction-provider": "./src/attempt/internal/interaction-provider.ts",
    "./attempt/internal/retry": "./src/attempt/internal/retry.ts",
    "./module": "./src/module/index.ts",
    "./module/catalog": "./src/module/catalog.ts",
    "./artifact": "./src/artifact/index.ts",
    "./storage": "./src/storage/index.ts",
    "./invitation": "./src/invitation/index.ts",
    "./audit": "./src/audit/index.ts",
    "./errors": "./src/errors.ts",
    "./workspace": "./src/workspace/index.ts",
    "./workspace/active-context": "./src/workspace/active-context.ts",
    "./venture": "./src/venture/index.ts",
    "./content-seed": "./src/content-seed/index.ts",
    "./content-seed/content/program": "./src/content-seed/content/program.ts",
    "./internal/slug": "./src/internal/slug.ts",
    "./internal/workspace": "./src/internal/workspace.ts",
    "./internal/venture": "./src/internal/venture.ts",
    "./internal/branch": "./src/internal/branch.ts",
    "./internal/program-version": "./src/internal/program-version.ts",
    "./internal/entity-id": "./src/internal/entity-id.ts",
    "./mcp-auth": "./src/mcp-auth/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/*.db.test.ts\"",
    "test:watch": "vitest",
    "test:db": "vitest run src/invitation/index.db.test.ts src/workspace/index.db.test.ts src/workspace/active-context.db.test.ts src/venture/index.db.test.ts src/content-seed/index.db.test.ts src/module/catalog.db.test.ts src/workflow/index.db.test.ts src/mcp-auth/index.db.test.ts src/attempt/index.db.test.ts",
    "seed": "tsx src/content-seed/cli.ts"
  },
  "dependencies": {
    "@ai-catalyst/clients": "workspace:*",
    "@ai-catalyst/contracts": "workspace:*",
    "@ai-catalyst/db": "workspace:*",
    "@ai-catalyst/shared": "workspace:*",
    "@ai-catalyst/toolkit-content": "workspace:*",
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
