    "./internal/slug": "./src/internal/slug.ts",
    "./internal/workspace": "./src/internal/workspace.ts",
    "./internal/venture": "./src/internal/venture.ts",
    "./internal/branch": "./src/internal/branch.ts",
    "./internal/program-version": "./src/internal/program-version.ts",
    "./internal/entity-id": "./src/internal/entity-id.ts",
    "./mcp-auth": "./src/mcp-auth/index.ts",
    "./testing/db-fixtures": "./src/testing/db-fixtures.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/*.db.test.ts\"",
    "test:watch": "vitest",
    "test:db": "vitest run src/invitation/index.db.test.ts src/workspace/index.db.test.ts src/workspace/active-context.db.test.ts src/venture/index.db.test.ts src/profile/index.db.test.ts src/company-profile/index.db.test.ts src/content-seed/index.db.test.ts src/module/catalog.db.test.ts src/module/context.db.test.ts src/module/completion.db.test.ts src/workflow/index.db.test.ts src/mcp-auth/index.db.test.ts src/attempt/index.db.test.ts src/storage/index.db.test.ts src/artifact/index.db.test.ts src/audit/index.db.test.ts",
    "seed": "tsx src/content-seed/cli.ts"
  },
  "dependencies": {
    "@ai-catalyst/clients": "workspace:*",
    "@ai-catalyst/contracts": "workspace:*",
    "@ai-catalyst/db": "workspace:*",
    "@ai-catalyst/shared": "workspace:*",
    "@ai-catalyst/toolkit-content": "workspace:*",
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/client-sesv2": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
