{
  "name": "@ai-catalyst/services",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Application Service Layer — the single home for business logic, consumed by apps/web route handlers and apps/mcp tool handlers. The only layer permitted to call apps/api (for internal AI calls).",
  "exports": {
    "./workflow": "./src/workflow/index.ts",
    "./attempt": "./src/attempt/index.ts",
    "./attempt/internal/interaction-provider": "./src/attempt/internal/interaction-provider.ts",
    "./attempt/internal/retry": "./src/attempt/internal/retry.ts",
    "./module": "./src/module/index.ts",
    "./module/catalog": "./src/module/catalog.ts",
    "./module/context": "./src/module/context.ts",
    "./module/completion": "./src/module/completion.ts",
    "./module/internal/setup-summary": "./src/module/internal/setup-summary.ts",
    "./module/internal/template-outline": "./src/module/internal/template-outline.ts",
    "./artifact": "./src/artifact/index.ts",
    "./artifact/internal/markdown-sections": "./src/artifact/internal/markdown-sections.ts",
    "./artifact/internal/validators/registry": "./src/artifact/internal/validators/registry.ts",
    "./artifact/internal/validators/pressure-test-verdict-v1": "./src/artifact/internal/validators/pressure-test-verdict-v1.ts",
    "./artifact/internal/validators/pressure-test-verdict-v2": "./src/artifact/internal/validators/pressure-test-verdict-v2.ts",
    "./artifact/internal/created-via": "./src/artifact/internal/created-via.ts",
    "./artifact/internal/triggered-via": "./src/artifact/internal/triggered-via.ts",
    "./storage": "./src/storage/index.ts",
    "./storage/config": "./src/storage/config.ts",
    "./storage/resolve-provider": "./src/storage/resolve-provider.ts",
    "./storage/providers/local": "./src/storage/providers/local.ts",
    "./storage/providers/s3": "./src/storage/providers/s3.ts",
    "./storage/internal/object-key": "./src/storage/internal/object-key.ts",
    "./storage/internal/validation": "./src/storage/internal/validation.ts",
    "./storage/internal/hash": "./src/storage/internal/hash.ts",
    "./email": "./src/email/index.ts",
    "./invitation": "./src/invitation/index.ts",
    "./audit": "./src/audit/index.ts",
    "./errors": "./src/errors.ts",
    "./workspace": "./src/workspace/index.ts",
    "./workspace/active-context": "./src/workspace/active-context.ts",
    "./venture": "./src/venture/index.ts",
    "./profile": "./src/profile/index.ts",
