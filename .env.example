# Monorepo/Docker-wide defaults. apps/web and apps/api each have their own
# .env.example scoped to what that app actually reads from process.env —
# copy this file's DATABASE_URL into both rather than duplicating every
# variable here.

# Matches infra/docker/docker-compose.yml's db service credentials and the
# 5432 port it publishes to the host.
DATABASE_URL=postgresql://ai_catalyst:ai_catalyst@127.0.0.1:5432/ai_catalyst

# Required by docker-compose.yml's web service (Better Auth's signing
# secret) — `pnpm docker:up` fails fast with a clear error if this is unset.
# Generate one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Ports docker-compose.yml publishes to the host; documented here so web,
# api, and mcp agree on where to find each other locally.
WEB_PORT=3000
API_PORT=8000
# Host-side only — the mcp container always listens on 8787 internally
# (docker-compose.yml sets that explicitly); override this if 8787 is
# already taken on your host.
MCP_HOST_PORT=8787
