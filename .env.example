# Monorepo/Docker-wide defaults. apps/web and apps/api each have their own
# .env.example scoped to what that app actually reads from process.env —
# copy this file's DATABASE_URL into both rather than duplicating every
# variable here.

# Matches infra/docker/docker-compose.yml's db service credentials and the
# 5432 port it publishes to the host.
DATABASE_URL=postgresql://ai_catalyst:ai_catalyst@127.0.0.1:5432/ai_catalyst

# Required by docker-compose.yml's web service (Better Auth's signing
# secret) — `pnpm docker:up` fails fast with a clear error if this is unset.
# Generate one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Ports docker-compose.yml publishes to the host; documented here so web,
# api, and mcp agree on where to find each other locally.
WEB_PORT=3000
API_PORT=8000
# Host-side only — the mcp container always listens on 8787 internally
# (docker-compose.yml sets that explicitly); override this if 8787 is
# already taken on your host.
MCP_HOST_PORT=8787

# Root directory the Local Storage Provider (packages/services/src/storage)
# reads/writes generated files under. Unset locally: defaults to
# `<repo-root>/.data/storage`, resolved the same way
# packages/toolkit-content/src/paths.ts finds its content root (never
# `process.cwd()`). docker-compose.yml overrides this to the absolute
# in-container path `/data/storage` for the web/mcp services — a relative
# value here is resolved against the repo root, not the process cwd, so it
# is only meaningful for local (non-Docker) runs.
# LOCAL_STORAGE_ROOT=.data/storage

# Cloud / Staging-Production (composition root only — providers never read
# these themselves). Leave unset locally; see infra/aws/README.md.
# STORAGE_PROVIDER=local
# STORAGE_PROVIDER=s3
# STORAGE_CONTAINER=ai-catalyst-artifacts-staging
# AWS_REGION=ap-southeast-2
# AWS_S3_ENDPOINT=
# EMAIL_PROVIDER=noop
# EMAIL_PROVIDER=ses
# EMAIL_FROM=noreply@example.com
