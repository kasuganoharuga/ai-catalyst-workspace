{
  "name": "ai-catalyst-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "cd apps/api && python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "dev": "concurrently \"pnpm dev:web\" \"pnpm dev:api\"",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up --build",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down",
    "lint": "pnpm --filter web lint",
    "typecheck:web": "pnpm --filter web typecheck",
    "format:check:web": "pnpm --filter web format:check",
    "format:web": "pnpm --filter web format",
    "build": "pnpm --filter web build"
  },
  "devDependencies": {
    "concurrently": "latest"
  }
}
